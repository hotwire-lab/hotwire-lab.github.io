---
import Layout from '../layouts/Layout.astro';
import { TOOLS } from '../data/tools';

const defaultPreview = TOOLS[1]; // Scope as initial hero preview
---

<Layout>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M2 12 C5 4, 8 4, 11 12 C14 20, 17 20, 20 12 L22 12"
            fill="none"
            stroke="#f0b429"
            stroke-width="2.2"
            stroke-linecap="round"
          />
        </svg>
        <span class="brand-name">HotWire Lab</span>
      </a>

      <nav class="topnav" aria-label="HotWire Tools">
        {TOOLS.map((tool) => (
          <a class="nav-item" href={tool.appUrl} title={tool.name}>
            <span class="ch-bar" style={`background:${tool.accent};`} />
            <span>{tool.shortName}</span>
          </a>
        ))}
      </nav>

      <div class="topbar-right">
        <a class="text-link" href="#hardware">Hardware</a>
        <a class="text-link" href="https://github.com/hotwire-lab" target="_blank" rel="noreferrer">
          GitHub ↗
        </a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="mono-kicker">RUST / WASM · WEB SERIAL &amp; WEBUSB · XIAO ESP32-S3 / C6</p>
          <h1>Four USB bench tools on one $5 ESP32.</h1>
          <p class="hero-lead">
            Logic analyzer, 4-channel oscilloscope, 1.84–2.79 GHz RF spectrum viewer, and
            USB/UART serial monitor running directly in Chrome or Edge on desktop and Android.
            Flash firmware from the browser, switch tools without re-granting USB permissions, or
            test offline in Demo mode.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#tools">Explore Tools ↓</a>
            <a class="btn btn-secondary" href="#get-hardware">Get Hardware ↓</a>
            <a
              class="btn btn-ghost"
              href="https://github.com/hotwire-lab"
              target="_blank"
              rel="noreferrer"
            >
              GitHub ↗
            </a>
          </div>

          <p class="compat-line">
            <strong>Note:</strong> Live USB requires Chrome, Edge, or Opera on Desktop or Android
            (USB-OTG). iOS/Safari runs in offline Demo mode.
          </p>
        </div>

        <div class="hero-preview" aria-label="Live tool screenshot preview">
          <div class="bezel-top">
            <div class="bezel-tabs" role="tablist" aria-label="Select tool screenshot">
              {TOOLS.map((tool) => (
                <button
                  type="button"
                  role="tab"
                  class={tool.slug === defaultPreview.slug ? 'bezel-tab active' : 'bezel-tab'}
                  aria-selected={tool.slug === defaultPreview.slug ? 'true' : 'false'}
                  data-preview-slug={tool.slug}
                  data-preview-img={tool.image}
                  data-preview-alt={tool.imageAlt}
                  data-preview-url={tool.appUrl}
                  data-preview-name={tool.name}
                  data-preview-short={tool.shortName}
                  data-preview-accent={tool.accent}
                >
                  <span class="tab-dot" style={`background:${tool.accent};`} />
                  {tool.shortName}
                </button>
              ))}
            </div>
            <span class="bezel-origin">hotwire-lab.github.io</span>
          </div>

          <a id="preview-link" class="bezel-screen" href={defaultPreview.appUrl}>
            <img
              id="preview-img"
              src={defaultPreview.image}
              alt={defaultPreview.imageAlt}
              width="960"
              height="600"
            />
          </a>

          <div class="bezel-foot">
            <span id="preview-caption" class="bezel-caption">{defaultPreview.name}</span>
            <a id="preview-cta" class="bezel-launch" href={defaultPreview.appUrl}>
              Open {defaultPreview.shortName} App →
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="tools" class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-index">01 / INSTRUMENTS</span>
          <h2>Four browser apps, one shared USB origin</h2>
          <p>
            All four PWAs run under <code>hotwire-lab.github.io</code>. Grant USB access once and
            jump between instruments directly from the top bar.
          </p>
        </div>

        <div class="tool-list">
          {TOOLS.map((tool) => (
            <article class="tool-row" style={`--tool-accent:${tool.accent};`}>
              <a class="tool-media" href={tool.appUrl}>
                <img src={tool.image} alt={tool.imageAlt} loading="lazy" />
              </a>

              <div class="tool-info">
                <div class="tool-head">
                  <span class="tool-ch">CH{tool.index} · {tool.shortName.toUpperCase()}</span>
                  <span class="tool-fw">{tool.firmwareMin}</span>
                </div>

                <h3>{tool.name}</h3>
                <p class="tool-summary">{tool.summary}</p>
                <p class="tool-note">{tool.note}</p>

                <dl class="spec-grid">
                  {tool.specs.map((spec) => (
                    <div class="spec-item">
                      <dt>{spec.label}</dt>
                      <dd>{spec.value}</dd>
                    </div>
                  ))}
                </dl>

                <div class="tool-actions">
                  <a class="btn btn-tool" href={tool.appUrl}>
                    Open {tool.shortName} App →
                  </a>
                  <a class="btn btn-ghost" href={tool.repoUrl} target="_blank" rel="noreferrer">
                    Source &amp; FW ↗
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="workflow" class="section section-rule">
      <div class="container">
        <div class="section-header">
          <span class="section-index">02 / WORKFLOW</span>
          <h2>From bare board to live measurement</h2>
        </div>

        <ol class="workflow-strip">
          <li>
            <span class="wf-num">01</span>
            <div>
              <h3>Connect over USB-C</h3>
              <p>
                Plug a XIAO ESP32-S3 or ESP32-C6 into a desktop USB port or Android phone via
                USB-OTG. No driver installation needed — or click <strong>Demo</strong> with no
                board attached.
              </p>
            </div>
          </li>
          <li>
            <span class="wf-num">02</span>
            <div>
              <h3>Flash in the browser</h3>
              <p>
                Open the built-in <strong>Flasher</strong> to program the bundled image. Connecting
                a board with another tool&apos;s firmware automatically triggers a switch prompt.
              </p>
            </div>
          </li>
          <li>
            <span class="wf-num">03</span>
            <div>
              <h3>Measure &amp; switch tools</h3>
              <p>
                Capture waveforms, decode buses, inspect 2.4 GHz spectrum, or bridge a 3.3 V UART
                from the same browser session — every app shares the <code>hotwire-core</code>{' '}
                transport.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section id="hardware" class="section section-rule">
      <div class="container">
        <div class="section-header">
          <span class="section-index">03 / HARDWARE &amp; PINOUT</span>
          <h2>Supported boards &amp; pin map</h2>
          <p>
            One Seeed Studio XIAO board covers all four tools. ESP32-S3 is the primary target for
            4-channel 1 MSPS Scope and PSRAM SDR; ESP32-C6 is supported across all four tools.
          </p>
        </div>

        <div class="hardware-layout">
          <figure class="pinout-card">
            <figcaption class="pinout-title">
              <span>XIAO ESP32-S3 / C6 PIN REFERENCE</span>
              <span class="pinout-volt">3.3 V MAX</span>
            </figcaption>
            <svg
              class="pinout-svg"
              viewBox="0 0 460 308"
              role="img"
              aria-label="Seeed Studio XIAO ESP32 pinout diagram showing D0 to D7 logic analyzer channels (software-mappable for I2C, SPI, UART), D0 to D3 ADC channels, D6 test generator and fixed Serial Bridge UART TX, D7 fixed Serial Bridge UART RX, 5V, GND, 3V3 power pins, and U.FL RF antenna connector"
            >
              <defs>
                <linearGradient id="usbc-metal" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#cbd5e1" />
                  <stop offset="55%" stop-color="#94a3b8" />
                  <stop offset="100%" stop-color="#64748b" />
                </linearGradient>
                <linearGradient id="shield-metal" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#e2e8f0" />
                  <stop offset="55%" stop-color="#cbd5e1" />
                  <stop offset="100%" stop-color="#aeb9c7" />
                </linearGradient>
              </defs>

              <!-- PCB Body (rounded black XIAO board) -->
              <rect x="166" y="32" width="128" height="214" rx="14" fill="#10141a" stroke="#2d3748" stroke-width="1.5" />

              <!-- USB-C Receptacle -->
              <rect x="197" y="8" width="66" height="44" rx="3" fill="url(#usbc-metal)" stroke="#475569" stroke-width="1" />
              <rect x="205" y="42" width="50" height="8" rx="1.5" fill="#1e293b" />
              <line x1="214" y1="42" x2="214" y2="50" stroke="#94a3b8" stroke-width="1.2" />
              <line x1="230" y1="42" x2="230" y2="50" stroke="#94a3b8" stroke-width="1.2" />
              <line x1="246" y1="42" x2="246" y2="50" stroke="#94a3b8" stroke-width="1.2" />
              <text x="230" y="29" text-anchor="middle" fill="#1e293b" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600">USB-C</text>

              <!-- R (Reset) & B (Boot) Buttons + Status LEDs -->
              <rect x="176" y="38" width="12" height="8" rx="1.5" fill="#cbd5e1" stroke="#475569" stroke-width="0.7" />
              <circle cx="182" cy="42" r="2.2" fill="#f8fafc" stroke="#64748b" stroke-width="0.6" />
              <text x="182" y="56" text-anchor="middle" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="7" font-weight="600">R</text>
              <rect x="180" y="59" width="4" height="7" rx="0.8" fill="#f59e0b" opacity="0.85" />

              <rect x="272" y="38" width="12" height="8" rx="1.5" fill="#cbd5e1" stroke="#475569" stroke-width="0.7" />
              <circle cx="278" cy="42" r="2.2" fill="#f8fafc" stroke="#64748b" stroke-width="0.6" />
              <text x="278" y="56" text-anchor="middle" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="7" font-weight="600">B</text>
              <rect x="276" y="59" width="4" height="7" rx="0.8" fill="#38bdf8" opacity="0.85" />

              <!-- Metallic RF Shield -->
              <rect x="185" y="70" width="90" height="108" rx="4" fill="url(#shield-metal)" stroke="#64748b" stroke-width="1" />
              <text x="230" y="106" text-anchor="middle" fill="#0f172a" font-family="IBM Plex Sans, sans-serif" font-size="10.5" font-weight="700" letter-spacing="-0.02em">seeed studio</text>
              <text x="230" y="124" text-anchor="middle" fill="#1e293b" font-family="IBM Plex Mono, monospace" font-size="9" font-weight="600">XIAO ESP32</text>
              <text x="230" y="139" text-anchor="middle" fill="#475569" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600">S3 / C6</text>
              <line x1="200" y1="150" x2="260" y2="150" stroke="#94a3b8" stroke-width="0.8" />
              <text x="230" y="164" text-anchor="middle" fill="#475569" font-family="IBM Plex Mono, monospace" font-size="7.5" font-weight="600">HOTWIRE LAB</text>

              <!-- Gold U.FL External Antenna Connector (bottom-left) -->
              <rect x="186" y="216" width="20" height="20" rx="2.5" fill="#ca9a2e" stroke="#facc15" stroke-width="0.8" />
              <circle cx="196" cy="226" r="6.5" fill="#10141a" stroke="#eab308" stroke-width="1.6" />
              <circle cx="196" cy="226" r="2.2" fill="#facc15" />

              <!-- Onboard Ceramic Chip Antenna (bottom-right) -->
              <rect x="228" y="220" width="42" height="12" rx="1.5" fill="#94a3b8" stroke="#475569" stroke-width="0.8" />
              <rect x="228" y="220" width="6" height="12" rx="1" fill="#cbd5e1" />
              <rect x="264" y="220" width="6" height="12" rx="1" fill="#cbd5e1" />
              <circle cx="249" cy="226" r="2" fill="#475569" />

              <!-- U.FL Antenna Callout Pill -->
              <polyline points="196,236 196,262 214,262" fill="none" stroke="#a855f7" stroke-width="1.1" />
              <rect x="122" y="253" width="216" height="18" rx="3" fill="#7e22ce" />
              <text x="230" y="265" text-anchor="middle" fill="#ffffff" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600">U.FL EXT. ANT · SDR 1.84–2.79 GHz</text>

              <!-- Left Pins: D0..D6 (Gold castellated pads + Seeed-style color pills) -->
              {[
                { pin: 'D0', y: 64, note: 'LA0 · ADC CH1', noteBg: '#d97706' },
                { pin: 'D1', y: 88, note: 'LA1 · ADC CH2', noteBg: '#d97706' },
                { pin: 'D2', y: 112, note: 'LA2 · ADC CH3', noteBg: '#d97706' },
                { pin: 'D3', y: 136, note: 'LA3 · ADC CH4*', noteBg: '#d97706' },
                { pin: 'D4', y: 160, note: 'LA4 · LOGIC CH4', noteBg: '#4d7c0f' },
                { pin: 'D5', y: 184, note: 'LA5 · LOGIC CH5', noteBg: '#4d7c0f' },
                { pin: 'D6', y: 208, note: 'LA6 · TX* · TEST', noteBg: '#0d9488' },
              ].map((p) => (
                <g>
                  <!-- Gold castellated pad -->
                  <circle cx="168" cy={p.y} r="5.5" fill="#d4a338" stroke="#854d0e" stroke-width="0.7" />
                  <circle cx="168" cy={p.y} r="2.6" fill="#0b0e12" />
                  <!-- Trace line -->
                  <line x1="154" y1={p.y} x2="162" y2={p.y} stroke="#475569" stroke-width="1" />
                  <!-- Pin name pill (GPIO green) -->
                  <rect x="124" y={p.y - 8.5} width="30" height="17" rx="3" fill="#65a30d" />
                  <text x="139" y={p.y + 3} text-anchor="middle" fill="#ffffff" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600">{p.pin}</text>
                  <!-- Function pill -->
                  <line x1="120" y1={p.y} x2="124" y2={p.y} stroke="#475569" stroke-width="1" />
                  <rect x="8" y={p.y - 8.5} width="112" height="17" rx="3" fill={p.noteBg} />
                  <text x="64" y={p.y + 3} text-anchor="middle" fill="#ffffff" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600">{p.note}</text>
                </g>
              ))}

              <!-- Right Pins: 5V, GND, 3V3, D10, D9, D8, D7 -->
              {[
                { pin: '5V', y: 64, pinBg: '#dc2626', pinText: '#ffffff', pinStroke: 'none', note: 'VBUS (USB)', noteBg: '#991b1b', noteText: '#fecaca', noteStroke: 'none' },
                { pin: 'GND', y: 88, pinBg: '#0b0e12', pinText: '#ffffff', pinStroke: '#cbd5e1', note: 'Common GND', noteBg: '#161b22', noteText: '#e2e8f0', noteStroke: '#64748b' },
                { pin: '3V3', y: 112, pinBg: '#ef4444', pinText: '#ffffff', pinStroke: 'none', note: '3.3V Ref Out', noteBg: '#991b1b', noteText: '#fecaca', noteStroke: 'none' },
                { pin: 'D10', y: 136, pinBg: '#27303d', pinText: '#94a3b8', pinStroke: 'none', note: 'GPIO / Unused', noteBg: '#171d26', noteText: '#64748b', noteStroke: '#2b3442' },
                { pin: 'D9', y: 160, pinBg: '#27303d', pinText: '#94a3b8', pinStroke: 'none', note: 'GPIO / Unused', noteBg: '#171d26', noteText: '#64748b', noteStroke: '#2b3442' },
                { pin: 'D8', y: 184, pinBg: '#27303d', pinText: '#94a3b8', pinStroke: 'none', note: 'GPIO / Unused', noteBg: '#171d26', noteText: '#64748b', noteStroke: '#2b3442' },
                { pin: 'D7', y: 208, pinBg: '#65a30d', pinText: '#ffffff', pinStroke: 'none', note: 'LA7 · UART RX*', noteBg: '#0d9488', noteText: '#ffffff', noteStroke: 'none' },
              ].map((p) => (
                <g>
                  <!-- Gold castellated pad -->
                  <circle cx="292" cy={p.y} r="5.5" fill="#d4a338" stroke="#854d0e" stroke-width="0.7" />
                  <circle cx="292" cy={p.y} r="2.6" fill="#0b0e12" />
                  <!-- Trace line -->
                  <line x1="298" y1={p.y} x2="306" y2={p.y} stroke="#475569" stroke-width="1" />
                  <!-- Pin name pill -->
                  <rect x="306" y={p.y - 8.5} width="32" height="17" rx="3" fill={p.pinBg} stroke={p.pinStroke} stroke-width="1" />
                  <text x="322" y={p.y + 3} text-anchor="middle" fill={p.pinText} font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600">{p.pin}</text>
                  <!-- Function pill -->
                  <line x1="338" y1={p.y} x2="342" y2={p.y} stroke="#475569" stroke-width="1" />
                  <rect x="342" y={p.y - 8.5} width="110" height="17" rx="3" fill={p.noteBg} stroke={p.noteStroke} stroke-width="1" />
                  <text x="397" y={p.y + 3} text-anchor="middle" fill={p.noteText} font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600">{p.note}</text>
                </g>
              ))}

              <!-- Color Legend Bar -->
              {[
                { label: 'POWER', x: 14, w: 58, bg: '#dc2626', stroke: 'none' },
                { label: 'GND', x: 78, w: 46, bg: '#0b0e12', stroke: '#cbd5e1' },
                { label: 'GPIO / LA', x: 130, w: 76, bg: '#65a30d', stroke: 'none' },
                { label: 'ADC', x: 212, w: 48, bg: '#d97706', stroke: 'none' },
                { label: 'UART* / TEST', x: 266, w: 96, bg: '#0d9488', stroke: 'none' },
                { label: 'RF / SDR', x: 368, w: 78, bg: '#7e22ce', stroke: 'none' },
              ].map((item) => (
                <g>
                  <rect x={item.x} y="284" width={item.w} height="16" rx="2.5" fill={item.bg} stroke={item.stroke} stroke-width="0.9" />
                  <text x={item.x + item.w / 2} y="295" text-anchor="middle" fill="#ffffff" font-family="IBM Plex Mono, monospace" font-size="7.5" font-weight="600">{item.label}</text>
                </g>
              ))}
            </svg>
            <p class="pinout-footnote">
              * ADC CH4 (D3) is available on XIAO ESP32-S3 (4 ch); C6 supports 3 ADC channels
              (D0–D2). In the Logic Analyzer, I²C, SPI, and UART decoders can be assigned to any
              <code>D0</code>–<code>D7</code> pin; only Serial Terminal Bridge UART pins (
              <code>D6</code> TX / <code>D7</code> RX) are fixed.
            </p>
          </figure>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tool</th>
                  <th>XIAO ESP32-S3</th>
                  <th>XIAO ESP32-C6</th>
                  <th>Key Pins</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Logic Analyzer</strong></td>
                  <td>8 ch · up to 20 MHz · 32 KB</td>
                  <td>8 ch · Dedicated GPIO / timer</td>
                  <td><code>D0</code>–<code>D7</code> (3.3 V)</td>
                </tr>
                <tr>
                  <td><strong>Oscilloscope</strong></td>
                  <td>4 ch · 83.3 kSPS / 1 MSPS OC</td>
                  <td>3 ch · 83.3 kSPS spec</td>
                  <td><code>D0</code>–<code>D3</code> · <code>D6</code> Gen</td>
                </tr>
                <tr>
                  <td><strong>SDR</strong></td>
                  <td>1.84–2.79 GHz · Dual-Core + PSRAM</td>
                  <td>1.84–2.79 GHz · External U.FL</td>
                  <td>U.FL antenna</td>
                </tr>
                <tr>
                  <td><strong>Serial Terminal</strong></td>
                  <td>Direct USB + D6/D7 Bridge</td>
                  <td>Direct USB + D6/D7 Bridge</td>
                  <td><code>D6</code> TX · <code>D7</code> RX</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div id="get-hardware" class="hardware-cta">
          <div class="hardware-buy-actions">
            <a
              class="btn btn-primary"
              href="https://www.seeedstudio.com/XIAO-ESP32S3-p-5627.html?sensecap_affiliate=KvCMmK9&referring_service=link"
              target="_blank"
              rel="sponsored noopener noreferrer"
            >
              Get XIAO ESP32-S3 ↗
            </a>
            <a
              class="btn btn-secondary"
              href="https://www.seeedstudio.com/Seeed-Studio-XIAO-ESP32C6-p-5884.html?sensecap_affiliate=KvCMmK9&referring_service=link"
              target="_blank"
              rel="sponsored noopener noreferrer"
            >
              Get XIAO ESP32-C6 ↗
            </a>
          </div>
          <p class="affiliate-title">Want to support HotWire Lab development?</p>
          <p class="affiliate-note">
            Use affiliate code{' '}
            <button type="button" class="code-copy" id="copy-code-btn" data-code="1PWLI2G3" title="Copy affiliate code">
              <code>1PWLI2G3</code>
              <span class="copy-label" id="copy-code-label">Copy</span>
            </button>{' '}
            at checkout for <strong>2% off</strong> XIAO series boards at no extra cost to you.
          </p>
        </div>

        <div class="safety-box">
          <strong>3.3 V Input Safety:</strong> Never apply voltages above <strong>3.3 V</strong> or
          negative voltages directly to XIAO GPIO/ADC pins. Use a 10:1 resistive divider or level
          shifter for higher-voltage circuits.
        </div>

        <div class="core-row">
          <div>
            <h3>Shared core: <code>hotwire-core</code></h3>
            <p>
              Rust/WASM crate unifying Web Serial, Android WebUSB (CDC-ACM, FTDI, CP210x, CH340,
              PL2303), zero-copy binary framing, firmware verification, in-browser flashing, and
              touch gestures across all four apps.
            </p>
          </div>
          <a
            class="btn btn-ghost"
            href="https://github.com/hotwire-lab/hotwire-core"
            target="_blank"
            rel="noreferrer"
          >
            hotwire-core on GitHub ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span>Kari Vierimaa, Kempele · Open Source (Apache-2.0 / GPL-3.0 SDR FW)</span>
      <div class="footer-links">
        <a href="https://hotwire-lab.github.io/logic/">Logic</a>
        <a href="https://hotwire-lab.github.io/scope/">Scope</a>
        <a href="https://hotwire-lab.github.io/sdr/">SDR</a>
        <a href="https://hotwire-lab.github.io/serial/">Serial</a>
        <a href="https://github.com/hotwire-lab" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const previewBox = document.querySelector('.hero-preview');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-preview-slug]'));
  const img = document.getElementById('preview-img') as HTMLImageElement | null;
  const link = document.getElementById('preview-link') as HTMLAnchorElement | null;
  const caption = document.getElementById('preview-caption');
  const cta = document.getElementById('preview-cta') as HTMLAnchorElement | null;

  let activeIndex = Math.max(
    0,
    tabs.findIndex((t) => t.classList.contains('active'))
  );
  let cleanupTimer: number | undefined;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function selectPreview(index: number, animate = false) {
    const tab = tabs[index];
    if (!tab) return;
    const isSameTab = index === activeIndex;
    activeIndex = index;

    tabs.forEach((t, i) => {
      const isSelected = i === index;
      t.classList.toggle('active', isSelected);
      t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
    });

    const src = tab.dataset.previewImg;
    const alt = tab.dataset.previewAlt;
    const url = tab.dataset.previewUrl;
    const name = tab.dataset.previewName;
    const shortName = tab.dataset.previewShort;

    if (link && url) link.href = url;
    if (caption && name) caption.textContent = name;
    if (cta && url && shortName) {
      cta.href = url;
      cta.textContent = `Open ${shortName} App →`;
    }

    if (!img || !src) return;

    if (!animate || reduceMotion || isSameTab || !link) {
      img.src = src;
      if (alt) img.alt = alt;
      return;
    }

    // Clean up any previous outgoing slide
    window.clearTimeout(cleanupTimer);
    link.querySelectorAll('.preview-outgoing').forEach((el) => el.remove());

    const outgoing = img.cloneNode(false) as HTMLImageElement;
    outgoing.removeAttribute('id');
    outgoing.className = 'preview-outgoing';
    outgoing.setAttribute('aria-hidden', 'true');
    outgoing.style.transform = 'translateX(0)';
    link.insertBefore(outgoing, img);

    img.style.transition = 'none';
    img.style.transform = 'translateX(100%)';
    img.src = src;
    if (alt) img.alt = alt;

    // Force reflow so the browser commits the starting positions
    void img.offsetWidth;

    img.style.transition = '';
    img.style.transform = 'translateX(0)';
    outgoing.style.transform = 'translateX(-100%)';

    cleanupTimer = window.setTimeout(() => {
      outgoing.remove();
    }, 380);
  }

  let rotateTimer: number | undefined;
  let isPaused = false;

  function startAutoRotate() {
    if (reduceMotion || tabs.length < 2) return;
    window.clearInterval(rotateTimer);
    rotateTimer = window.setInterval(() => {
      if (isPaused || document.hidden) return;
      selectPreview((activeIndex + 1) % tabs.length, true);
    }, 4500);
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      selectPreview(index, true);
      startAutoRotate();
    });
  });

  if (previewBox) {
    previewBox.addEventListener('mouseenter', () => {
      isPaused = true;
    });
    previewBox.addEventListener('mouseleave', () => {
      isPaused = false;
    });
    previewBox.addEventListener('focusin', () => {
      isPaused = true;
    });
    previewBox.addEventListener('focusout', () => {
      isPaused = false;
    });
  }

  startAutoRotate();

  const copyBtn = document.getElementById('copy-code-btn') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copy-code-label');
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      const code = copyBtn.dataset.code || '1PWLI2G3';
      try {
        await navigator.clipboard.writeText(code);
        copyLabel.textContent = 'Copied';
        window.setTimeout(() => {
          copyLabel.textContent = 'Copy';
        }, 1800);
      } catch {
        copyLabel.textContent = code;
      }
    });
  }
</script>

