---
import Layout from '../layouts/Layout.astro';
import { TOOLS } from '../data/tools';
---

<Layout>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="/">
        <span class="brand-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20">
            <path
              d="M2 12 C5 4, 8 4, 11 12 C14 20, 17 20, 20 12 L22 12"
              fill="none"
              stroke="#38bdf8"
              stroke-width="2.2"
              stroke-linecap="round"
            />
          </svg>
        </span>
        <span class="brand-name">HotWire Lab</span>
      </a>

      <nav class="tool-switcher" aria-label="HotWire Tools">
        {TOOLS.map((tool) => (
          <a class="tool-tab" href={tool.appUrl} title={tool.name}>
            <span class="tool-dot" style={`background:${tool.accent};`} />
            <span>{tool.shortName}</span>
          </a>
        ))}
      </nav>

      <div class="topbar-links">
        <a class="nav-link" href="#hardware">Hardware</a>
        <a class="nav-link" href="https://github.com/hotwire-lab" target="_blank" rel="noreferrer">
          GitHub ↗
        </a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="eyebrow">Rust + WebAssembly · Web Serial &amp; WebUSB · Zero Drivers</div>
        <h1>
          Turn a $5 ESP32 into a<br />
          <span class="grad-text">browser hardware lab.</span>
        </h1>
        <p class="hero-lead">
          Four zero-install Progressive Web Apps — <strong>Logic Analyzer</strong>,{' '}
          <strong>Oscilloscope</strong>, <strong>1.84–2.79 GHz SDR</strong>, and{' '}
          <strong>Serial Terminal</strong> — powered by{' '}
          <strong>Seeed Studio XIAO ESP32-S3</strong> &amp; <strong>ESP32-C6</strong> with built-in
          browser flashing and offline <strong>Demo</strong> simulators.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#tools">Launch a Tool ↓</a>
          <a class="btn btn-secondary" href="https://github.com/hotwire-lab" target="_blank" rel="noreferrer">
            GitHub Organization
          </a>
        </div>

        <div class="pill-row">
          <span class="pill">Chrome / Edge Desktop &amp; Android</span>
          <span class="pill">Built-in <code>esptool-js</code> Flasher</span>
          <span class="pill">Shared USB Permissions Across All 4 Tools</span>
          <span class="pill">Offline Demo Mode Included</span>
        </div>
      </div>
    </section>

    <section id="tools" class="section">
      <div class="container">
        <div class="section-head">
          <h2>The Four HotWire Tools</h2>
          <p>
            Every app runs at the same origin (<code>hotwire-lab.github.io</code>), so granting USB
            access once lets you switch seamlessly between tools from the top bar.
          </p>
        </div>

        <div class="tools-grid">
          {TOOLS.map((tool) => (
            <article class="tool-card" style={`--card-accent:${tool.accent};`}>
              <a class="card-media" href={tool.appUrl}>
                <img src={tool.image} alt={tool.imageAlt} loading="lazy" />
                <span class="fw-badge">FW {tool.firmwareMin}</span>
              </a>

              <div class="card-body">
                <div class="card-title-row">
                  <span class="card-dot" style={`background:${tool.accent};`} />
                  <h3>{tool.name}</h3>
                </div>
                <p class="card-tagline">{tool.tagline}</p>
                <p class="card-desc">{tool.description}</p>

                <ul class="chip-list">
                  {tool.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>

                <div class="card-actions">
                  <a class="btn btn-launch" href={tool.appUrl}>
                    Open {tool.shortName} App →
                  </a>
                  <a class="btn btn-ghost" href={tool.repoUrl} target="_blank" rel="noreferrer">
                    Source &amp; FW
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="quickstart" class="section section-alt">
      <div class="container">
        <div class="section-head">
          <h2>Quick Start in 60 Seconds</h2>
          <p>No Arduino IDE, drivers, or desktop software required to start measuring.</p>
        </div>

        <div class="steps-grid">
          <div class="step-card">
            <span class="step-num">1</span>
            <h3>Plug in XIAO ESP32</h3>
            <p>
              Connect a <strong>Seeed Studio XIAO ESP32-S3</strong> or <strong>XIAO ESP32-C6</strong>{' '}
              via USB-C (or USB-OTG on Android) and open any HotWire tool in Chrome or Edge — or click{' '}
              <strong>Demo</strong> with no hardware attached.
            </p>
          </div>
          <div class="step-card">
            <span class="step-num">2</span>
            <h3>Flash in Your Browser</h3>
            <p>
              Click <strong>⚡ Flasher</strong> to program the bundled firmware directly via{' '}
              <code>esptool-js</code>. If the board holds another tool&apos;s firmware or an older
              version, HotWire detects it automatically and prompts you to switch.
            </p>
          </div>
          <div class="step-card">
            <span class="step-num">3</span>
            <h3>Measure &amp; Switch Tools</h3>
            <p>
              Jump between <strong>Logic</strong>, <strong>Scope</strong>, <strong>SDR</strong>, and{' '}
              <strong>Serial</strong> directly from the unified top toolbar. All four tools share
              one tested <code>hotwire-core</code> Rust/WASM transport layer.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="hardware" class="section">
      <div class="container">
        <div class="section-head">
          <h2>Supported Hardware &amp; Shared Core</h2>
          <p>
            One pocket-sized board covers digital logic, analog waveforms, 2.4 GHz RF spectrum, and
            3.3 V UART bridging.
          </p>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Tool</th>
                <th>XIAO ESP32-S3</th>
                <th>XIAO ESP32-C6</th>
                <th>Key Pins</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Logic Analyzer</strong></td>
                <td>8 ch · up to 20 MHz · 32 KB</td>
                <td>8 ch · Dedicated GPIO / timer</td>
                <td><code>D0</code>–<code>D7</code> (3.3 V logic)</td>
              </tr>
              <tr>
                <td><strong>Oscilloscope</strong></td>
                <td>4 ch · 83.3 kSPS spec / 1 MSPS OC</td>
                <td>3 ch · 83.3 kSPS spec</td>
                <td><code>D0</code>–<code>D3</code> ADC · <code>D6</code> Test Gen</td>
              </tr>
              <tr>
                <td><strong>SDR</strong></td>
                <td>1.84–2.79 GHz · Dual-Core + PSRAM</td>
                <td>1.84–2.79 GHz · External U.FL</td>
                <td>External U.FL antenna</td>
              </tr>
              <tr>
                <td><strong>Serial Terminal</strong></td>
                <td>Direct USB + D6/D7 UART Bridge</td>
                <td>Direct USB + D6/D7 UART Bridge</td>
                <td><code>D6</code> TX · <code>D7</code> RX (3.3 V TTL)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="safety-box">
          <strong>⚠ 3.3 V Input Safety:</strong> Never apply voltages above <strong>3.3 V</strong>{' '}
          or negative voltages directly to XIAO GPIO/ADC pins. Use a 10:1 resistive divider or
          level shifter for higher-voltage circuits.
        </div>

        <div class="core-banner">
          <div>
            <h3>Powered by <code>hotwire-core</code></h3>
            <p>
              Shared Rust/WASM library encapsulating Web Serial, Android WebUSB drivers
              (CDC-ACM, FTDI, CP210x, CH340, PL2303), zero-copy binary framing, firmware handshake
              verification, <code>esptool-js</code> flashing, and touch gestures.
            </p>
          </div>
          <a
            class="btn btn-secondary"
            href="https://github.com/hotwire-lab/hotwire-core"
            target="_blank"
            rel="noreferrer"
          >
            Explore hotwire-core →
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span>Copyright © 2026 Kari Vierimaa, Kempele · Open Source (Apache 2.0 / GPL-3.0 SDR FW)</span>
      <div class="footer-links">
        <a href="https://hotwire-lab.github.io/logic/">Logic</a>
        <a href="https://hotwire-lab.github.io/scope/">Scope</a>
        <a href="https://hotwire-lab.github.io/sdr/">SDR</a>
        <a href="https://hotwire-lab.github.io/serial/">Serial</a>
        <a href="https://github.com/hotwire-lab" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Topbar matching HotWireToolbar aesthetic */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(19, 25, 34, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 54px;
    flex-wrap: wrap;
    padding-top: 8px;
    padding-bottom: 8px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.2px;
  }

  .brand-icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #0a0f17;
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
  }

  .tool-switcher {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px;
    border-radius: 9px;
    background: #0a0f17;
    border: 1px solid var(--border);
  }

  .tool-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    transition: background 0.14s, color 0.14s;
  }

  .tool-tab:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .tool-dot,
  .card-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .topbar-links {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .nav-link:hover {
    color: var(--text);
  }

  /* Hero */
  .hero {
    padding: 72px 0 56px;
    text-align: center;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 18px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.35rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.02em;
    max-width: 780px;
    margin-bottom: 18px;
  }

  .grad-text {
    background: linear-gradient(95deg, #38bdf8 0%, #a855f7 52%, #4ade80 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    max-width: 680px;
    font-size: 16px;
    color: var(--muted);
    margin-bottom: 26px;
  }

  .hero-lead strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .pill {
    font-size: 12px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 5px 11px;
    border-radius: 999px;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 8px;
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--border);
    transition: background 0.14s, border-color 0.14s, transform 0.12s;
    cursor: pointer;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: #0284c7;
    border-color: #0ea5e9;
    color: #fff;
  }

  .btn-primary:hover {
    background: #0369a1;
  }

  .btn-secondary {
    background: var(--surface-2);
    color: var(--text);
  }

  .btn-secondary:hover {
    border-color: #4b5d7a;
    background: #222d40;
  }

  .btn-launch {
    flex: 1;
    background: color-mix(in srgb, var(--card-accent) 16%, var(--surface-2));
    border-color: color-mix(in srgb, var(--card-accent) 55%, var(--border));
    color: var(--text);
  }

  .btn-launch:hover {
    background: color-mix(in srgb, var(--card-accent) 26%, var(--surface-2));
    border-color: var(--card-accent);
  }

  .btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--muted);
  }

  .btn-ghost:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  /* Sections */
  .section {
    padding: 56px 0;
  }

  .section-alt {
    background: rgba(19, 25, 34, 0.55);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .section-head {
    max-width: 680px;
    margin-bottom: 28px;
  }

  .section-head h2 {
    font-size: 24px;
    font-weight: 750;
    margin-bottom: 6px;
  }

  .section-head p {
    color: var(--muted);
    font-size: 14px;
  }

  /* Tool Cards */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .tool-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.16s, box-shadow 0.16s, transform 0.16s;
  }

  .tool-card:hover {
    border-color: color-mix(in srgb, var(--card-accent) 65%, var(--border));
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.38);
    transform: translateY(-2px);
  }

  .card-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: #070b11;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }

  .tool-card:hover .card-media img {
    transform: scale(1.02);
  }

  .fw-badge {
    position: absolute;
    right: 10px;
    top: 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(13, 17, 23, 0.85);
    border: 1px solid var(--border);
    color: var(--text);
  }

  .card-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-title-row h3 {
    font-size: 17px;
    font-weight: 700;
  }

  .card-tagline {
    font-size: 13px;
    font-weight: 600;
    color: var(--card-accent);
  }

  .card-desc {
    font-size: 13.5px;
    color: var(--muted);
    flex: 1;
  }

  .chip-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip-list li {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: var(--text);
    background: #0a0f17;
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .card-actions {
    display: flex;
    gap: 8px;
    margin-top: 6px;
  }

  /* Steps */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .step-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: rgba(56, 189, 248, 0.14);
    border: 1px solid rgba(56, 189, 248, 0.4);
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    font-size: 13px;
    display: grid;
    place-items: center;
  }

  .step-card h3 {
    font-size: 15px;
  }

  .step-card p {
    font-size: 13.5px;
    color: var(--muted);
  }

  /* Hardware table */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  th,
  td {
    padding: 11px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  tr:last-child td {
    border-bottom: none;
  }

  th {
    background: var(--surface-2);
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .safety-box {
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 10px;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.35);
    color: #fde68a;
    font-size: 13px;
  }

  .core-banner {
    margin-top: 22px;
    padding: 20px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }

  .core-banner h3 {
    font-size: 16px;
    margin-bottom: 6px;
  }

  .core-banner p {
    max-width: 680px;
    font-size: 13.5px;
    color: var(--muted);
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--border);
    padding: 22px 0;
    color: var(--muted);
    font-size: 12.5px;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer-links {
    display: inline-flex;
    gap: 14px;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  @media (max-width: 820px) {
    .tools-grid,
    .steps-grid {
      grid-template-columns: 1fr;
    }

    .topbar-links {
      display: none;
    }
  }
</style>
